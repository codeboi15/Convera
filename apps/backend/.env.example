# ── App ──
APP_ENV=development
DEBUG=true

# ── Data ──
# Both app (async) and Alembic (sync) use the psycopg v3 driver on this URL.
DATABASE_URL=postgresql+psycopg://intercom:intercom@localhost:5432/intercom
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Frontend / CORS ──
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Email (Postmark) ──
# Leave blank until you create a Postmark server. Inbound can use the free
# Postmark inbound address (no domain required).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_INBOUND_SECRET=

# ── AI (Anthropic Claude) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
