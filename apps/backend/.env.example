# ── App ──
APP_ENV=development
DEBUG=true

# ── Data ──
# Both app (async) and Alembic (sync) use the psycopg v3 driver on this URL.
DATABASE_URL=postgresql+psycopg://intercom:intercom@localhost:5432/intercom
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Frontend / CORS ──
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Email channel ──
# Transport: "imap" (poll a mailbox), "postmark" (webhook), or "stub" (no-op).
EMAIL_PROVIDER=stub
# The single mailbox that receives mail for EVERY workspace. Each workspace is
# addressed with a plus-tag (support+acme@...), which selects the tenant — so
# onboarding a workspace never requires any change at the email provider.
EMAIL_INBOUND_ADDRESS=support@yourdomain.com
EMAIL_FROM_NAME=Support

# IMAP/SMTP adapter (works with any mailbox — no domain or provider approval)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Postmark adapter
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Shared secret appended to the webhook URL: /api/webhooks/postmark/inbound?token=...
POSTMARK_INBOUND_SECRET=

# ── AI (Anthropic Claude) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
