# ── App ──
APP_ENV=development
DEBUG=true

# ── Data ──
# Both app (async) and Alembic (sync) use the psycopg v3 driver on this URL.
DATABASE_URL=postgresql+psycopg://intercom:intercom@localhost:5432/intercom
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Frontend / CORS ──
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Email channel ──
# Inbound transport: "imap" (poll a mailbox), "postmark" (webhook), "stub".
EMAIL_PROVIDER=stub
# Outbound transport, when it must differ from inbound: "brevo", "resend",
# "imap", "postmark", "stub". Blank = same as EMAIL_PROVIDER.
# Several hosting platforms (Railway included) block outbound SMTP entirely —
# ports 587 and 465 both fail with "Network is unreachable" — so mail has to
# leave over HTTPS while inbound still arrives by IMAP.
EMAIL_OUTBOUND_PROVIDER=

# Brevo (HTTPS, 300/day free, verifies a single sender address — no domain needed)
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# SendGrid (HTTPS, 100/day free, single-sender verification, no IP allowlist)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Resend (HTTPS) — needs a verified sending domain to mail arbitrary recipients
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# The single mailbox that receives mail for EVERY workspace. Each workspace is
# addressed with a plus-tag (support+acme@...), which selects the tenant — so
# onboarding a workspace never requires any change at the email provider.
EMAIL_INBOUND_ADDRESS=support@yourdomain.com
EMAIL_FROM_NAME=Support

# IMAP/SMTP adapter (works with any mailbox — no domain or provider approval)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Postmark adapter
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Shared secret appended to the webhook URL: /api/webhooks/postmark/inbound?token=...
POSTMARK_INBOUND_SECRET=

# ── Custom domains ──
# Who issues the TLS certificate for a customer's domain:
#   manual  — you add the domain to your host yourself (default)
#   caddy   — Caddy on-demand TLS calls /api/public/domains/authorize
#   vercel  — the Vercel Domains API is called automatically
DOMAIN_PROVIDER=manual
# What customers point their CNAME record at.
DOMAIN_CNAME_TARGET=cname.vercel-dns.com
# Only needed when DOMAIN_PROVIDER=vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── AI (Anthropic Claude) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
