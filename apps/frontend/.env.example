# All frontend configuration lives in src/lib/config.ts, which reads these.
# NOTE: NEXT_PUBLIC_* values are compiled into the browser bundle — never put
# secrets here. Secrets belong on the backend only.

# Base URL of the FastAPI backend (REST).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Socket.IO endpoint. Falls back to NEXT_PUBLIC_API_URL when omitted.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Public origin of this app; used to build the widget install snippet.
# In production set this to the deployed frontend URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
